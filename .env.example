# =============================================================================
# AetherMask Environment Configuration (.env.example)
# Copy this file to .env for local deployment customization.
# All settings default to safe, offline, air-gapped values.
# =============================================================================

# --- Server Binding ---
# Host network interface to bind (default: 127.0.0.1).
# Use 0.0.0.0 only inside isolated containers with network_mode: none.
AETHERMASK_HOST=127.0.0.1

# Server listening port (default: 8000).
AETHERMASK_PORT=8000

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
AETHERMASK_LOG_LEVEL=INFO

# --- Air-Gap & Security Policies ---
# Egress Sentinel: Set to 1 to block and raise on any non-loopback socket connections.
# Set to 0 only for permissive debug logging without enforcement.
AETHERMASK_BLOCK_EGRESS=1

# Allow loopback/private RFC-1918 database DSN strings (default: 1).
# Set to 0 to forbid even local database connections.
AETHERMASK_ALLOW_LOCAL_PG=1

# Maximum allowable upload payload size in megabytes (default: 2048).
AETHERMASK_MAX_UPLOAD_MB=2048

# --- Cryptographic Vault & KDF Tuning ---
# Argon2id memory cost in KiB (default: 262144 KiB = 256 MiB).
# In constrained test or CI environments, this may be tuned to 32768.
AETHERMASK_ARGON2_MEMORY_KIB=262144

# Argon2id time cost / iteration count (default: 4).
AETHERMASK_ARGON2_TIME=4

# Argon2id parallelism lanes (default: 2).
AETHERMASK_ARGON2_PARALLELISM=2

# --- Frontend & UI ---
# Absolute or relative path to pre-built SPA dist directory.
# If omitted, defaults to frontend/dist relative to project root.
AETHERMASK_STATIC_DIR=frontend/dist

# --- Optional Offline NLP ---
# Path to a locally vendored spaCy language model directory or wheel.
# Leave blank to use the built-in deterministic rule-based NER engine.
# AETHERMASK_SPACY_MODEL=/opt/models/en_core_web_sm
